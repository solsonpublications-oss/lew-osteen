# Database configuration (SQLite via Prisma)
DATABASE_URL="file:../db/custom.db"

# Admin Dashboard Password (used to unlock /admin)
ADMIN_KEY="change-me-to-a-secure-password"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (optional: leave empty for demo simulation mode)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (optional: leave empty for demo simulation mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# SMTP Email (optional: leave empty for demo simulation mode - emails log to server console)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lew Osteen <orders@lewosteen.com>"

# Author notification recipient
AUTHOR_EMAIL="lew@lewosteen.com"

# Lulu Print-on-Demand (optional: leave empty for demo simulation mode)
LULU_CLIENT_ID=
LULU_CLIENT_SECRET=
LULU_BASE_URL="https://api.lulu.com"
